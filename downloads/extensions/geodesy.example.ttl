@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatuk: <https://w3id.org/dcat-ap-uk/ns#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix eufreq: <http://publications.europa.eu/resource/authority/frequency/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dataset/geodesy> a dcat:Dataset ;
    dct:accessRights <https://w3id.org/dcat-ap-uk/codelist/access-rights/open> ;
    dct:accrualPeriodicity eufreq:MONTHLY ;
    dct:description "An invented dataset used to show an extension. It does not exist." ;
    dct:identifier "synthetic-0001" ;
    dct:license <http://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/> ;
    dct:modified "2026-10-01"^^xsd:date ;
    dct:publisher <https://www.gov.uk/government/organisations/government-digital-service> ;
    dct:spatial <http://statistics.data.gov.uk/id/statistical-geography/K03000001> ;
    dct:title "Synthetic coordinate time series for a survey control network" ;
    dcat:contactPoint [ a vcard:Kind ;
            vcard:fn "Example data team" ;
            vcard:hasURL <https://example.org/contact> ] ;
    dcat:keyword "example" ;
    dcat:theme <https://w3id.org/dcat-ap-uk/codelist/theme/government> ;
    dcatuk:confidenceLevel 95.0 ;
    dcatuk:coordinateEpoch 2025.0 ;
    dcatuk:horizontalUncertainty 0.01 ;
    dcatuk:observationTechnique <https://w3id.org/dcat-ap-uk/codelist/geodetic-technique/gnss> ;
    dcatuk:personalData <https://w3id.org/dcat-ap-uk/codelist/personal-data/none> ;
    dcatuk:referenceFrame <http://www.opengis.net/def/crs/EPSG/0/9067> ;
    dcatuk:securityClassification <https://w3id.org/dcat-ap-uk/codelist/security-classification/official> ;
    dcatuk:verticalUncertainty 0.02 .

