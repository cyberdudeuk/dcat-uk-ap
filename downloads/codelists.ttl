<https://w3id.org/dcat-ap-uk/codelist/transfer-mechanism/law-enforcement> a skos:Concept ;
    skos:definition "A transfer by a competent authority under Part 3 of the Data Protection Act 2018, which has its own rules."@en ;
    skos:inScheme ukcl:transfer-mechanism ;
    skos:notation "law-enforcement" ;
    skos:prefLabel "Law enforcement transfer rules"@en ;
    skos:topConceptOf ukcl:transfer-mechanism .

<https://w3id.org/dcat-ap-uk/codelist/transfer-mechanism/not-restricted> a skos:Concept ;
    skos:definition "The ICO three-step test shows the flow is not a restricted transfer, for example because the receiver is not a separate legal entity, or the data is not personal data in the receiver's hands."@en ;
    skos:inScheme ukcl:transfer-mechanism ;
    skos:notation "not-restricted" ;
    skos:prefLabel "Not a restricted transfer"@en ;
    skos:topConceptOf ukcl:transfer-mechanism .

<https://w3id.org/dcat-ap-uk/codelist/transfer-mechanism/public-body-instrument> a skos:Concept ;
    skos:definition "A legally binding and enforceable instrument between public authorities or bodies."@en ;
    skos:inScheme ukcl:transfer-mechanism ;
    skos:notation "public-body-instrument" ;
    skos:prefLabel "Instrument between public authorities"@en ;
    skos:topConceptOf ukcl:transfer-mechanism .

<https://w3id.org/dcat-ap-uk/codelist/transfer-mechanism/uk-adequacy> a skos:Concept ;
    skos:definition "The receiver is in a country, territory or international organisation covered in full by UK adequacy regulations, known as data bridges. Since the Data (Use and Access) Act 2025 came into force on 5 February 2026, the test is that protection there is not materially lower than in the UK."@en ;
    skos:inScheme ukcl:transfer-mechanism ;
    skos:notation "uk-adequacy" ;
    skos:prefLabel "UK adequacy regulations (data bridge)"@en ;
    skos:topConceptOf ukcl:transfer-mechanism .

<https://w3id.org/dcat-ap-uk/codelist/transfer-mechanism/uk-adequacy-partial> a skos:Concept ;
    skos:definition "Covered by adequacy regulations for a sector or a class of receiver only, such as organisations certified to the UK-US data bridge."@en ;
    skos:inScheme ukcl:transfer-mechanism ;
    skos:notation "uk-adequacy-partial" ;
    skos:prefLabel "Partial UK adequacy regulations"@en ;
    skos:topConceptOf ukcl:transfer-mechanism .

<https://w3id.org/dcat-ap-uk/codelist/transport-security/not-assessed> a skos:Concept ;
    skos:definition "Not yet checked. Checking is part of the discovery work the NCSC asks for by 2028."@en ;
    skos:inScheme ukcl:transport-security ;
    skos:notation "not-assessed" ;
    skos:prefLabel "Not yet assessed"@en ;
    skos:topConceptOf ukcl:transport-security .

<https://w3id.org/dcat-ap-uk/codelist/transport-security/pqc-hybrid> a skos:Concept ;
    skos:definition "Negotiates a post-quantum key exchange (ML-KEM, FIPS 203) combined with a classical one, such as X25519MLKEM768 in TLS 1.3."@en ;
    skos:inScheme ukcl:transport-security ;
    skos:notation "pqc-hybrid" ;
    skos:prefLabel "Hybrid post-quantum"@en ;
    skos:topConceptOf ukcl:transport-security .

<https://w3id.org/dcat-ap-uk/codelist/transport-security/pqc-only> a skos:Concept ;
    skos:definition "Negotiates a post-quantum key exchange alone."@en ;
    skos:inScheme ukcl:transport-security ;
    skos:notation "pqc-only" ;
    skos:prefLabel "Post-quantum only"@en ;
    skos:topConceptOf ukcl:transport-security .

<https://w3id.org/dcat-ap-uk/codelist/transport-security/tls12-classical> a skos:Concept ;
    skos:definition "Upgrade to TLS 1.3 first; post-quantum key exchange needs it."@en ;
    skos:inScheme ukcl:transport-security ;
    skos:notation "tls12-classical" ;
    skos:prefLabel "TLS 1.2 with classical key exchange"@en ;
    skos:topConceptOf ukcl:transport-security .

<https://w3id.org/dcat-ap-uk/codelist/transport-security/tls13-classical> a skos:Concept ;
    skos:definition "Secure against today's attackers, but data recorded now could be decrypted later by a quantum computer (harvest now, decrypt later). Plan the migration."@en ;
    skos:inScheme ukcl:transport-security ;
    skos:notation "tls13-classical" ;
    skos:prefLabel "TLS 1.3 with classical key exchange"@en ;
    skos:topConceptOf ukcl:transport-security .

<https://www.parliament.uk/site-information/copyright-parliament/open-parliament-licence/> skos:inScheme ukcl:licences ;
    skos:prefLabel "Open Parliament Licence v3.0"@en .

ukcl:access-rights a skos:ConceptScheme ;
    skos:definition "Who can get the data, and on what terms."@en ;
    skos:prefLabel "Access rights"@en .

ukcl:spatial-representation-type a skos:ConceptScheme ;
    skos:definition "How geographic information is represented, from the INSPIRE register of ISO 19115 spatial representation types, as GeoDCAT-AP uses them."@en ;
    skos:prefLabel "Spatial representation types"@en .

ukcl:licences a skos:ConceptScheme ;
    skos:definition "Licences commonly used for UK public sector data, and a value for when no licence applies and an agreement is needed."@en ;
    skos:prefLabel "Licences"@en .

ukcl:metadata-audience a skos:ConceptScheme ;
    skos:definition "Who may see the metadata record. Provisional, pending research (issue 5)."@en ;
    skos:prefLabel "Who can see this record"@en .

ukcl:open-data-triage a skos:ConceptScheme ;
    skos:definition "The outcome of open data triage for data that is presumed open, as in the energy sector's Data Best Practice guidance. Used by the energy extension (provenance K)."@en ;
    skos:prefLabel "Open data triage outcome"@en .

ukcl:security-classification a skos:ConceptScheme ;
    skos:definition "Classifications and the main marking from the Government Security Classifications Policy (version 2.0, August 2024)."@en ;
    skos:prefLabel "Security classification"@en .

ukcl:agent-role a skos:ConceptScheme ;
    skos:definition "Roles an organisation can play for a resource. Roles, never people."@en ;
    skos:prefLabel "Responsible role"@en .

ukcl:ai-use a skos:ConceptScheme ;
    skos:definition "Whether the data may be used to train, fine-tune or evaluate AI models. Used by the AI-ready extension. Provisional."@en ;
    skos:prefLabel "Use for artificial intelligence"@en .

ukcl:missing-reason a skos:ConceptScheme ;
    skos:definition "Why a property is empty on purpose. Based on the nil reasons of GML 3.2 and the INSPIRE void reasons, so records can be mapped to geospatial and allied metadata that use the same idea."@en ;
    skos:prefLabel "Reasons a value is missing"@en .

ukcl:personal-data a skos:ConceptScheme ;
    skos:definition "Whether the data contains information about identifiable living people (UK GDPR)."@en ;
    skos:prefLabel "Personal data"@en .

ukcl:statistics-status a skos:ConceptScheme ;
    skos:definition "The status of statistics under the Code of Practice for Statistics, as the Office for Statistics Regulation names them. Used by the statistics extension (provenance K)."@en ;
    skos:prefLabel "Official statistics status"@en .

ukcl:transport-security a skos:ConceptScheme ;
    skos:definition "The key exchange a service's endpoint uses to protect data in transit, for the post-quantum migration inventory."@en ;
    skos:prefLabel "Connection security"@en .

ukcl:checksum-algorithm a skos:ConceptScheme ;
    skos:definition "Algorithms in the SPDX list for checking a file has not changed, with this profile's advice on each for long-term and quantum-era trust."@en ;
    skos:prefLabel "Checksum algorithms"@en .

ukcl:geodetic-technique a skos:ConceptScheme ;
    skos:definition "How geodetic positions, heights or reference frame products were observed. A candidate list for the geodesy module."@en ;
    skos:prefLabel "Geodetic observation techniques"@en .

ukcl:sensitive-data a skos:ConceptScheme ;
    skos:definition "Kinds of information that need extra care beyond being personal."@en ;
    skos:prefLabel "Sensitive data"@en .

ukcl:service-type a skos:ConceptScheme ;
    skos:definition "The style of interface a data service offers. Use conformsTo for the exact standard."@en ;
    skos:prefLabel "Interface style"@en .

ukcl:service-status a skos:ConceptScheme ;
    skos:definition "Phases of a service, from the Service Manual."@en ;
    skos:prefLabel "Service status"@en .

ukcl:transfer-mechanism a skos:ConceptScheme ;
    skos:definition "The bases in UK GDPR for sending personal data outside the UK, as the ICO guidance of 15 January 2026 sets them out (provenance S)."@en ;
    skos:prefLabel "Transfer safeguards"@en .

ukcl:theme a skos:ConceptScheme ;
    skos:definition "The 14 data.gov.uk topics (read on 6 November 2026), each mapped to the EU data themes used by DCAT-AP."@en ;
    skos:prefLabel "Theme"@en .

ukcl:jurisdiction a skos:ConceptScheme ;
    skos:definition "Countries and territories where data may be held, processed or sent, including the UK nations, the Crown Dependencies, the British Overseas Territories, the Commonwealth, the EEA and others."@en ;
    skos:prefLabel "Jurisdictions"@en .

