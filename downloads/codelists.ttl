inspiresrt:grid skos:inScheme ukcl:spatial-representation-type ;
    skos:prefLabel "Grid"@en .

inspiresrt:stereoModel skos:inScheme ukcl:spatial-representation-type ;
    skos:prefLabel "Stereo model"@en .

