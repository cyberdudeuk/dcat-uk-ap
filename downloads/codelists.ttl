    skos:prefLabel "SHA-512"@en .

<http://www.nationalarchives.gov.uk/doc/non-commercial-government-licence/version/2/> skos:inScheme ukcl:licences ;
    skos:prefLabel "Non-Commercial Government Licence v2.0"@en .

<http://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/> skos:inScheme ukcl:licences ;
    skos:prefLabel "Open Government Licence v3.0"@en .

<https://creativecommons.org/licenses/by/4.0/> skos:inScheme ukcl:licences ;
    skos:prefLabel "Creative Commons Attribution 4.0"@en .

<https://creativecommons.org/publicdomain/zero/1.0/> skos:inScheme ukcl:licences ;
    skos:prefLabel "Creative Commons Zero 1.0"@en .

<https://w3id.org/dcat-ap-uk/codelist/access-rights/commercial> a skos:Concept ;
    skos:closeMatch euaccess:RESTRICTED ;
    skos:definition "The data is available to anyone, for a fee or under commercial terms."@en ;
    skos:hiddenLabel "COMMERCIAL" ;
    skos:inScheme ukcl:access-rights ;
    skos:notation "commercial" ;
    skos:prefLabel "Commercial"@en ;
    skos:scopeNote "Say in the rights statement how to buy or licence it."@en ;
    skos:topConceptOf ukcl:access-rights .

<https://w3id.org/dcat-ap-uk/codelist/access-rights/internal> a skos:Concept ;
    skos:closeMatch euaccess:NON_PUBLIC ;
    skos:definition "The data is available only to public sector organisations, or to named organisations, under an agreement."@en ;
    skos:hiddenLabel "INTERNAL" ;
    skos:inScheme ukcl:access-rights ;
    skos:notation "internal" ;
    skos:prefLabel "Internal to the public sector"@en ;
    skos:scopeNote "Say in the rights statement which agreement or legal gateway is needed. Finer levels are being researched (issue 5)."@en ;
    skos:topConceptOf ukcl:access-rights .

<https://w3id.org/dcat-ap-uk/codelist/access-rights/open> a skos:Concept ;
    skos:definition "Anyone can get the data, without registering or asking."@en ;
    skos:exactMatch euaccess:PUBLIC ;
    skos:hiddenLabel "OPEN" ;
    skos:inScheme ukcl:access-rights ;
    skos:notation "open" ;
    skos:prefLabel "Open"@en ;
    skos:scopeNote "Usually published under the Open Government Licence. Check the security classification is OFFICIAL and the data contains no personal data unless lawfully published."@en ;
    skos:topConceptOf ukcl:access-rights .

<https://w3id.org/dcat-ap-uk/codelist/agent-role/data-custodian> a skos:Concept ;
    skos:definition "Runs the systems that hold the data."@en ;
    skos:inScheme ukcl:agent-role ;
    skos:notation "data-custodian" ;
    skos:prefLabel "Data custodian"@en ;
    skos:topConceptOf ukcl:agent-role .

<https://w3id.org/dcat-ap-uk/codelist/agent-role/data-owner> a skos:Concept ;
    skos:definition "Accountable for the data asset, its use and its quality. Named as a post, not a person."@en ;
    skos:inScheme ukcl:agent-role ;
    skos:notation "data-owner" ;
    skos:prefLabel "Data owner"@en ;
    skos:topConceptOf ukcl:agent-role .

<https://w3id.org/dcat-ap-uk/codelist/agent-role/data-steward> a skos:Concept ;
    skos:definition "Looks after the data day to day: its metadata, quality and access."@en ;
    skos:inScheme ukcl:agent-role ;
    skos:notation "data-steward" ;
    skos:prefLabel "Data steward"@en ;
    skos:topConceptOf ukcl:agent-role .

<https://w3id.org/dcat-ap-uk/codelist/agent-role/distributor> a skos:Concept ;
    skos:definition "Makes the data available on behalf of the publisher."@en ;
    skos:inScheme ukcl:agent-role ;
    skos:notation "distributor" ;
    skos:prefLabel "Distributor"@en ;
    skos:topConceptOf ukcl:agent-role .

<https://w3id.org/dcat-ap-uk/codelist/agent-role/information-asset-owner> a skos:Concept ;
    skos:definition "The senior role accountable for the information asset under information assurance."@en ;
    skos:inScheme ukcl:agent-role ;
    skos:notation "information-asset-owner" ;
    skos:prefLabel "Information asset owner"@en ;
    skos:topConceptOf ukcl:agent-role .

<https://w3id.org/dcat-ap-uk/codelist/ai-use/evaluation-only> a skos:Concept ;
    skos:definition "The data may be used to test or evaluate AI models, but not to train them."@en ;
    skos:inScheme ukcl:ai-use ;
    skos:notation "evaluation-only" ;
    skos:prefLabel "Evaluation only"@en ;
    skos:topConceptOf ukcl:ai-use .

<https://w3id.org/dcat-ap-uk/codelist/ai-use/not-assessed> a skos:Concept ;
    skos:definition "The owner has not decided. Treat as not permitted until they do."@en ;
    skos:inScheme ukcl:ai-use ;
    skos:notation "not-assessed" ;
    skos:prefLabel "Not yet assessed"@en ;
    skos:topConceptOf ukcl:ai-use .

<https://w3id.org/dcat-ap-uk/codelist/ai-use/not-permitted> a skos:Concept ;
    skos:definition "The data must not be used to train, fine-tune or evaluate AI models."@en ;
    skos:inScheme ukcl:ai-use ;
    skos:notation "not-permitted" ;
    skos:prefLabel "Not permitted"@en ;
    skos:topConceptOf ukcl:ai-use .

<https://w3id.org/dcat-ap-uk/codelist/ai-use/permitted> a skos:Concept ;
    skos:definition "The data may be used to train and fine-tune AI models under its licence, with no further conditions."@en ;
    skos:inScheme ukcl:ai-use ;
    skos:notation "permitted" ;
    skos:prefLabel "Training permitted"@en ;
    skos:topConceptOf ukcl:ai-use .

<https://w3id.org/dcat-ap-uk/codelist/ai-use/permitted-with-conditions> a skos:Concept ;
    skos:definition "The data may be used for AI training under conditions in the usage policy or rights statement, such as attribution, non-commercial use or a data sharing agreement."@en ;
    skos:inScheme ukcl:ai-use ;
    skos:notation "permitted-with-conditions" ;
    skos:prefLabel "Training permitted with conditions"@en ;
    skos:topConceptOf ukcl:ai-use .

<https://w3id.org/dcat-ap-uk/codelist/geodetic-technique/doris> a skos:Concept ;
    skos:definition "Doppler orbitography and radiopositioning integrated by satellite."@en ;
    skos:inScheme ukcl:geodetic-technique ;
    skos:notation "doris" ;
    skos:prefLabel "DORIS"@en ;
    skos:topConceptOf ukcl:geodetic-technique .

