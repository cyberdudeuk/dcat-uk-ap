@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatuk: <https://w3id.org/dcat-ap-uk/ns#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix eufreq: <http://publications.europa.eu/resource/authority/frequency/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/dcat-ap-uk/examples/eligibility-decisions> a dcat:Dataset ;
    dct:accessRights <https://w3id.org/dcat-ap-uk/codelist/access-rights/internal> ;
    dct:accrualPeriodicity eufreq:DAILY ;
    dct:conformsTo <https://example.org/dcat-ap-uk/examples/eligibility-decisions/schema.json> ;
    dct:created "2024-04-01"^^xsd:date ;
    dct:creator <https://example.org/organisations/example-department> ;
    dct:description "Synthetic example. One row per eligibility decision, with the date, the outcome and the reason code. Shared with partner organisations to deliver the scheme." ;
    dct:identifier "7f3c9a1e-58b2-4c3d-9e60-2b8f4a1d0c77" ;
    dct:license <https://w3id.org/dcat-ap-uk/codelist/licences/data-sharing-agreement-required> ;
    dct:modified "2026-10-01"^^xsd:date ;
    dct:publisher <https://example.org/organisations/example-department> ;
    dct:rights "Shared under a data sharing agreement using the public service delivery powers in the Digital Economy Act 2017. Ask through the contact form." ;
    dct:temporal [ a dct:PeriodOfTime ;
            dcat:startDate "2024-04-01"^^xsd:date ] ;
    dct:title "Eligibility decisions for an example support scheme" ;
    dcat:contactPoint [ a vcard:Kind ;
            vcard:fn "Example scheme data team" ;
            vcard:hasURL <https://example.org/contact/scheme-data> ] ;
    dcat:theme <https://w3id.org/dcat-ap-uk/codelist/theme/society> ;
    prov:qualifiedAttribution [ a prov:Attribution ;
            dcat:hadRole <https://w3id.org/dcat-ap-uk/codelist/agent-role/data-steward> ;
            prov:agent <https://example.org/organisations/example-department> ],
        [ a prov:Attribution ;
            dcat:hadRole <https://w3id.org/dcat-ap-uk/codelist/agent-role/data-owner> ;
            prov:agent <https://example.org/organisations/example-department> ] ;
    dcatuk:criticalDataAsset true ;
    dcatuk:metadataAudience <https://w3id.org/dcat-ap-uk/codelist/metadata-audience/public-sector> ;
    dcatuk:personalData <https://w3id.org/dcat-ap-uk/codelist/personal-data/pseudonymised> ;
    dcatuk:securityClassification <https://w3id.org/dcat-ap-uk/codelist/security-classification/official-sensitive> ;
    dcatuk:sensitiveData <https://w3id.org/dcat-ap-uk/codelist/sensitive-data/none> .

