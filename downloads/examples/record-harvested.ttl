@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatuk: <https://w3id.org/dcat-ap-uk/ns#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/central-catalogue/record/eligibility-decisions> a dcat:CatalogRecord ;
    dct:conformsTo <https://w3id.org/dcat-ap-uk/1.2> ;
    dct:issued "2026-10-01"^^xsd:date ;
    dct:modified "2026-11-06"^^xsd:date ;
    dct:source <https://example.org/catalogue/record/eligibility-decisions> ;
    foaf:primaryTopic <https://example.org/dcat-ap-uk/examples/eligibility-decisions> ;
    dcatuk:enrichedProperty dcat:theme ;
    dcatuk:metadataAudience <https://w3id.org/dcat-ap-uk/codelist/metadata-audience/public-sector> ;
    dcatuk:securityClassification <https://w3id.org/dcat-ap-uk/codelist/security-classification/official> .

